# Restyle the New Tab page: soft gradient, panther, centered favorites.
#
# The page's background becomes a soft gradient made from the theme's New Tab
# background and text colors, so it stays neutral in the default theme and
# follows other themes. The one-color panther from the app icon (DECISION-10)
# sits in the bottom-left corner in a faint tint of the theme's text color
# (panther.svg comes from branding/overlay, generated by
# scripts/make-icon.swift). The favorites grid is centered and adds rows as it
# grows. Theme images still replace the gradient and hide the panther. See
# devbacklog TASK-23.

--- a/chrome/browser/resources/new_tab_page_third_party/BUILD.gn
+++ b/chrome/browser/resources/new_tab_page_third_party/BUILD.gn
@@ -9,7 +9,10 @@ assert(enable_webui_ntp)
 
 build_webui("build") {
   grd_prefix = "new_tab_page_third_party"
-  static_files = [ "new_tab_page_third_party.html" ]
+  static_files = [
+    "new_tab_page_third_party.html",
+    "panther.svg",
+  ]
   ts_files = [
     "browser_proxy.ts",
     "new_tab_page_third_party.ts",
--- a/chrome/browser/resources/new_tab_page_third_party/new_tab_page_third_party.html
+++ b/chrome/browser/resources/new_tab_page_third_party/new_tab_page_third_party.html
@@ -8,8 +8,9 @@
       html {
         --ntp-focus-shadow-color: rgba(var(--google-blue-600-rgb), .4);
         --ntp-theme-text-color: var(--google-grey-800);
+        --pantera-background: $i18n{colorBackground};
         background-attachment: fixed;
-        background-color: $i18n{colorBackground};
+        background-color: var(--pantera-background);
         background-position: $i18n{backgroundPosition};
         background-repeat: $i18n{backgroundTiling};
         height: 100%;
@@ -23,6 +24,21 @@
         }
       }
 
+      /* A soft gradient from the theme's colors, over the whole window. */
+      html::before {
+        background-image: linear-gradient(200deg, var(--pantera-background) 35%,
+            color-mix(in srgb, var(--pantera-background),
+                var(--ntp-theme-text-color) 6%));
+        content: '';
+        inset: 0;
+        position: fixed;
+        z-index: -1;
+      }
+
+      html[has-custom-background]::before {
+        display: none;
+      }
+
       html[has-custom-background] {
         background-image: image-set(
             url(chrome://theme/IDR_THEME_NTP_BACKGROUND?$i18n{themeId}) 1x,
@@ -31,10 +47,33 @@
 
       body {
         align-items: center;
+        box-sizing: border-box;
         display: flex;
-        height: 100vh;
         justify-content: center;
         margin: 0;
+        min-height: 100vh;
+        padding: 48px 0;
+      }
+
+      /* The panther from the app icon, in one faint color from the theme's
+         text: the eye and whiskers are cut out to the background. */
+      #panther {
+        --panther-size: min(42vh, 36vw);
+        background-color: color-mix(in srgb, var(--ntp-theme-text-color) 7%,
+            transparent);
+        bottom: 0;
+        height: var(--panther-size);
+        left: calc(var(--panther-size) * -0.12);
+        mask-image: url(panther.svg);
+        mask-repeat: no-repeat;
+        mask-size: contain;
+        pointer-events: none;
+        position: fixed;
+        width: var(--panther-size);
+      }
+
+      html[has-custom-background] #panther {
+        display: none;
       }
 
       cr-most-visited {
@@ -50,6 +89,7 @@
   </head>
   <body>
     <script type="module" src="strings.m.js"></script>
