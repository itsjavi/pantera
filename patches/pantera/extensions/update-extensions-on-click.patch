# Update extensions only when the user asks.
#
# ungoogled-chromium's disable-webstore-urls.patch stops ExtensionDownloader
# from ever starting an update check. This restores the checks and the
# store's default update URL, then gates every check in
# ExtensionUpdater::CheckNow(): only the Update button in chrome://extensions
# (foreground priority) runs one, unless automatic updates are enabled
# (always off for now; devbacklog TASK-13 adds the opt-in setting).
#
# Store extensions go through ExtensionDownloader instead of UpdateService,
# whose component-updater server stays disabled. Usage pings stay off: the
# downloader only sends them to ping_enabled_domain ("google.com"), which
# domain substitution rewrites. See devbacklog TASK-3 and DECISION-5.

--- a/extensions/browser/updater/extension_downloader.cc
+++ b/extensions/browser/updater/extension_downloader.cc
@@ -158,7 +158,7 @@
                                       const GURL& update_url) {
   if (update_url.is_empty()) {
     // Fill in default update URL.
-    return std::nullopt;
+    return extension_urls::GetWebstoreUpdateUrl();
   }
 
   // Skip extensions with non-empty invalid update URLs.
@@ -176,6 +176,11 @@
     return std::nullopt;
   }
 
+  // Make sure we use SSL for store-hosted extensions.
+  if (extension_urls::IsWebstoreUpdateUrl(update_url) &&
+      !update_url.SchemeIsCryptographic()) {
+    return extension_urls::GetWebstoreUpdateUrl();
+  }
 
   return update_url;
 }
@@ -347,6 +352,10 @@
     AddToFetches(fetches_preparing, std::move(task));
   pending_tasks_.clear();
 
+  for (auto& fetch_list : fetches_preparing) {
+    for (auto& fetch : fetch_list.second)
+      StartUpdateCheck(std::move(fetch));
+  }
 }
 
