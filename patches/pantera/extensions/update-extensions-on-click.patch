 void ExtensionUpdater::CheckNow(CheckParams params) {
+  // Pantera: each check tells the update server (Google, for store
+  // extensions) the IP address and the installed extensions, so checks only
+  // run when the user asks, unless automatic updates are enabled. The Update
+  // button in chrome://extensions is the only caller with a foreground
+  // priority. Startup, scheduled, policy, external-install and
+  // runtime.requestUpdateCheck() checks finish without contacting anyone.
+  if (params.fetch_priority != DownloadFetchPriority::kForeground &&
+      !AutomaticUpdatesEnabled()) {
+    if (params.callback) {
+      content::GetUIThreadTaskRunner({})->PostTask(FROM_HERE,
+                                                   std::move(params.callback));
