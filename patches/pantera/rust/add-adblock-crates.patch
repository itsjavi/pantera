# Add Brave's adblock-rust crate to Chromium's Rust dependencies.
#
# Chromium's crate manifest gains adblock 0.13.3 with brave-core's features
# (TASK-31, DECISION-13). The rest is what Chromium's gnrt tool generated from
# that: the lockfile, per-crate config for the new crates, and BUILD.gn changes
# for crates Chromium already has. regex and siphasher stop being test-only,
# aho-corasick, which Chromium only used in tests, is allowed its unsafe code,
# bitflags gains its serde feature, serde and serde_core their rc feature and
# stable_deref_trait its std feature. The new crates themselves (sources,
# BUILD.gn and README.chromium files, and gnrt patches adding three missing
# license files) are copied from third_party/ by build.sh.
#
# Regenerate it with scripts/update-rust-crates.sh (docs/rust-crates.md).

diff --git a/third_party/rust/aho_corasick/v1/BUILD.gn b/third_party/rust/aho_corasick/v1/BUILD.gn
--- a/third_party/rust/aho_corasick/v1/BUILD.gn
+++ b/third_party/rust/aho_corasick/v1/BUILD.gn
@@ -58,7 +58,7 @@ cargo_crate("lib") {
   cargo_pkg_repository = "https://github.com/BurntSushi/aho-corasick"
   cargo_pkg_version = "1.1.5"
 
-  allow_unsafe = false
+  allow_unsafe = true
 
   deps = [ "//third_party/rust/memchr/v2:lib" ]
   features = [
