# Run Pantera's cosmetic filters in every frame.
#
# Pantera's cosmetic filtering lives in //pantera (DECISION-13, DECISION-20,
# devbacklog TASK-33). This hooks it into Chrome: an isolated world for its
# scripts, the renderer's frame observer and document-start call (before
# extensions, as brave-core does), the browser's binder for the frames'
# requests, and the script's resources in resources.pak, with a grit range
# after Pantera's strings.

--- a/chrome/common/chrome_isolated_world_ids.h
+++ b/chrome/common/chrome_isolated_world_ids.h
@@ -24,6 +24,9 @@
   ISOLATED_WORLD_ID_APPLESCRIPT,
 #endif  // BUILDFLAG(IS_MAC)
 
+  // Isolated world ID for Pantera's cosmetic filters.
+  ISOLATED_WORLD_ID_PANTERA_COSMETIC_FILTERS,
+
   // Numbers for isolated worlds for extensions are set in
   // extensions/renderer/script_injection.cc, and are are greater than or equal
   // to this number.
--- a/chrome/renderer/chrome_content_renderer_client.cc
+++ b/chrome/renderer/chrome_content_renderer_client.cc
@@ -150,6 +150,7 @@
 #include "mojo/public/cpp/bindings/generic_pending_receiver.h"
 #include "mojo/public/cpp/bindings/remote.h"
 #include "net/base/net_errors.h"
+#include "pantera/renderer/pantera_render_frame_hooks.h"
 #include "pdf/buildflags.h"
 #include "printing/buildflags/buildflags.h"
 #include "services/network/public/cpp/is_potentially_trustworthy.h"
@@ -852,6 +853,9 @@
   // Wire up the PageStabilityMonitorManager to allow components to
   // request stability monitors for this frame.
   new page_content_annotations::PageStabilityMonitorManager(render_frame);
+
+  // Pantera's cosmetic filters.
+  pantera::RenderFrameCreated(render_frame);
 }
 
 void ChromeContentRendererClient::WebViewCreated(
@@ -1486,6 +1490,9 @@
 
 void ChromeContentRendererClient::RunScriptsAtDocumentStart(
     content::RenderFrame* render_frame) {
+  // Pantera's cosmetic filters run before extensions.
+  pantera::RunScriptsAtDocumentStart(render_frame);
+
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
   extensions::ExtensionsRendererClient::Get()->RunScriptsAtDocumentStart(
       render_frame);
