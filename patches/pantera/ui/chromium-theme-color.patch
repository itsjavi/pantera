# Keep Chromium's own default theme as a theme color, after Pantera's two.
#
# Pantera's palette replaces Chromium's default (DECISION-8), which the user
# wants to keep as a choice. The theme color picker gets a "Chromium" color
# right after Pantera's Default and Grey. Its seed is Chromium's primary, and
# when it's chosen the mixers use Chromium's own default palette and surfaces
# (AddBaselinePalette, no sys overrides) instead of a palette generated from
# the seed, so it looks exactly like Chromium. Its swatch shows Chromium's
# default colors. See devbacklog TASK-28.

--- /dev/null
+++ b/ui/color/chromium_theme.h
@@ -0,0 +1,25 @@
+// Pantera: the "Chromium" theme color, which brings back Chromium's own default
+// theme after Pantera's (DECISION-8, devbacklog TASK-28).
+
+#ifndef UI_COLOR_CHROMIUM_THEME_H_
+#define UI_COLOR_CHROMIUM_THEME_H_
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_provider_key.h"
+
+namespace ui {
+
+// The seed of the "Chromium" color in the theme color picker: the primary of
+// Chromium's default palette.
+inline constexpr SkColor kChromiumThemeSeed = SkColorSetRGB(0x0B, 0x57, 0xD0);
+
+// Whether `key` is the "Chromium" theme color, which uses Chromium's default
+// palette and surfaces instead of a palette generated from the seed.
+inline bool IsChromiumTheme(const ColorProviderKey& key) {
+  return key.user_color_source == ColorProviderKey::UserColorSource::kAccent &&
+         key.user_color == kChromiumThemeSeed;
+}
+
+}  // namespace ui
+
+#endif  // UI_COLOR_CHROMIUM_THEME_H_
