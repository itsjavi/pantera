+// Adds the dynamic color palette tokens based on user_color. This is the base
+// palette so it is independent of ColorMode.
+void AddGeneratedPalette(ColorProvider* provider,
+                         SkColor seed_color,
+                         ColorProviderKey::SchemeVariant variant) {
+  AddPalette(provider, GeneratePalette(seed_color, variant).get());
+}
+
+// Adds Pantera's default palette. Dark mode is charcoal (DECISION-8): neutral
+// and neutral-variant tones (both zero-chroma grays) up to 25 are halved, then
+// ease back to their own value at 40, so the tab strip, toolbar, pages and
+// lines between them are near black but still apart.
+void AddPanteraPalette(ColorProvider* provider,
+                       ColorProviderKey::ColorMode color_mode) {
+  const PanteraPalette palette;
+  AddPalette(provider, &palette);
+  if (color_mode != ColorProviderKey::ColorMode::kDark) {
+    return;
+  }
+
+  static constexpr auto kDarkNeutrals =
+      std::to_array<std::pair<ColorId, float>>({
+          {kColorRefNeutral4, 4},   {kColorRefNeutral6, 6},
+          {kColorRefNeutral8, 8},   {kColorRefNeutral10, 10},
+          {kColorRefNeutral12, 12}, {kColorRefNeutral15, 15},
+          {kColorRefNeutral17, 17}, {kColorRefNeutral20, 20},
+          {kColorRefNeutral22, 22}, {kColorRefNeutral24, 24},
+          {kColorRefNeutral25, 25}, {kColorRefNeutral30, 30},
+          {kColorRefNeutralVariant10, 10}, {kColorRefNeutralVariant15, 15},
+          {kColorRefNeutralVariant20, 20}, {kColorRefNeutralVariant30, 30},
+      });
+  ColorMixer& mixer = provider->AddMixer();
+  for (const auto& [id, tone] : kDarkNeutrals) {
+    const float charcoal =
+        tone <= 25 ? tone / 2 : 12.5f + (tone - 25) * 27.5f / 15;
+    mixer[id] = {palette.neutral().get(charcoal)};
+  }
+}
