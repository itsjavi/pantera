# Show Pantera's version on the About page, with Chromium's under it.
#
# Chromium's About page shows one line, "Version 156.0.8078.47 (Official
# Build, ungoogled-chromium) (arm64)". Pantera's shows its own version
# ("Pantera 0.1.0 (Official Build) (arm64)"), the Chromium version it's
# built on ("Chromium: 156.0.8078.47 (ungoogled-chromium)"), and, since
# Pantera has no updater yet, that it doesn't check for updates. See devbacklog
# TASK-24.

--- a/chrome/app/settings_strings.grdp
+++ b/chrome/app/settings_strings.grdp
@@ -43,6 +43,15 @@
     <message name="IDS_SETTINGS_ABOUT_PAGE_BROWSER_VERSION" desc="The text label describing the version of the browser, example: Version 57.0.2937.0-r123456 (Developer Build) unknown (64-bit). The suffix of the version (eg. '-r123456') exists only in limited cases.)">
       Version <ph name="PRODUCT_VERSION">$1<ex>15.0.865.0</ex></ph><ph name="PRODUCT_VERSION_SUFFIX">$2<ex>-r123456</ex></ph>  (<ph name="PRODUCT_CHANNEL">$3<ex>Developer Build</ex></ph>) <ph name="PRODUCT_MODIFIER">$4</ph> <ph name="PRODUCT_VERSION_BITS">$5</ph>
     </message>
+    <message name="IDS_SETTINGS_ABOUT_PAGE_PANTERA_VERSION" desc="Pantera's own version on the About page, example: Pantera 0.1.0 (Official Build) (arm64).">
+      <ph name="PRODUCT_NAME">$1<ex>Pantera</ex></ph> <ph name="PRODUCT_VERSION">$2<ex>0.1.0</ex></ph> (Official Build) <ph name="PRODUCT_VERSION_BITS">$3<ex>(arm64)</ex></ph>
+    </message>
+    <message name="IDS_SETTINGS_ABOUT_PAGE_CHROMIUM_VERSION" desc="The version of Chromium that Pantera is built on, on the About page.">
+      Chromium: <ph name="CHROMIUM_VERSION">$1<ex>156.0.8078.47</ex></ph> (ungoogled-chromium)
+    </message>
+    <message name="IDS_SETTINGS_ABOUT_PAGE_NO_UPDATE_CHECKS" desc="Shown on the About page while Pantera has no updater.">
+      <ph name="PRODUCT_NAME">$1<ex>Pantera</ex></ph> doesn't check for updates yet
+    </message>
     <message name="IDS_SETTINGS_ABOUT_PAGE_LEARN_MORE_UPDATE_ERRORS" desc="The accessibility label for a 'Learn more' link next to an error message about how an update has failed.">
       Learn more about fixing update errors
     </message>
--- a/chrome/browser/ui/webui/settings/settings_localized_strings_provider.cc
+++ b/chrome/browser/ui/webui/settings/settings_localized_strings_provider.cc
@@ -68,6 +68,7 @@
 #include "chrome/common/channel_info.h"
 #include "chrome/common/chrome_features.h"
 #include "chrome/common/chrome_switches.h"
+#include "chrome/common/chrome_version.h"
 #include "chrome/common/pref_names.h"
 #include "chrome/common/url_constants.h"
 #include "chrome/grit/branded_strings.h"
@@ -110,6 +111,7 @@
 #include "components/signin/public/base/signin_buildflags.h"
 #include "components/signin/public/base/signin_switches.h"
 #include "components/strings/grit/components_branded_strings.h"
+#include "components/version_info/version_info.h"
 #include "components/strings/grit/components_strings.h"
 #include "components/subresource_filter/core/browser/subresource_filter_features.h"
 #include "components/subscription_eligibility/subscription_eligibility_service.h"
@@ -350,10 +352,26 @@
       l10n_util::GetStringUTF16(IDS_SETTINGS_UPGRADE_UP_TO_DATE));
 #endif
 
-  std::u16string browser_version = VersionUI::GetAnnotatedVersionStringForUi();
+  // Pantera's version leads, as "Pantera 0.1.0 (Official Build) (arm64)", with
+  // Chromium's on its own line and a note that updates aren't checked yet.
+  const std::u16string product_name =
+      l10n_util::GetStringUTF16(IDS_PRODUCT_NAME);
+  std::u16string browser_version = l10n_util::GetStringFUTF16(
+      IDS_SETTINGS_ABOUT_PAGE_PANTERA_VERSION, product_name,
+      u"" PANTERA_VERSION_STRING,
+      l10n_util::GetStringUTF16(VersionUI::VersionProcessorVariation()));
 
   html_source->AddString("aboutBrowserVersion", browser_version);
   html_source->AddString(
+      "aboutChromiumVersion",
+      l10n_util::GetStringFUTF16(
+          IDS_SETTINGS_ABOUT_PAGE_CHROMIUM_VERSION,
+          base::UTF8ToUTF16(version_info::GetVersionNumber())));
+  html_source->AddString(
+      "aboutNoUpdateChecks",
+      l10n_util::GetStringFUTF16(IDS_SETTINGS_ABOUT_PAGE_NO_UPDATE_CHECKS,
+                                 product_name));
+  html_source->AddString(
       "aboutProductCopyright",
       base::i18n::MessageFormatter::FormatWithNumberedArgs(
           l10n_util::GetStringUTF16(IDS_ABOUT_VERSION_COPYRIGHT),
--- a/chrome/browser/resources/settings/about_page/about_page.html.ts
