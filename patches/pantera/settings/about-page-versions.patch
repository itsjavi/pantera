@@ -55,7 +55,9 @@
         </a>
       </span>
 </if>
+      <div class="secondary">$i18n{aboutNoUpdateChecks}</div>
       <div class="secondary">$i18n{aboutBrowserVersion}</div>
+      <div class="secondary">$i18n{aboutChromiumVersion}</div>
     </div>
 <if expr="not is_chromeos">
