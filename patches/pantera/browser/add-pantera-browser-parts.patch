# Start Pantera's browser-wide services and register their prefs.
#
# Pantera's browser-process code lives in //pantera/browser (DECISION-13).
# Chrome's main parts gain PanteraBrowserMainExtraParts, which starts the
# ad-block service before profiles load (TASK-32), and RegisterLocalState()
# registers Pantera's local state prefs.

--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -2015,6 +2015,9 @@
       "//chrome/common/request_header_integrity",
     ]
   }
+
+  # Pantera's browser-process code (DECISION-13).
+  deps += [ "//pantera/browser" ]
 }
 
 # This target no longer has any sources of its own; it only aggregates
--- a/chrome/browser/chrome_browser_main.cc
+++ b/chrome/browser/chrome_browser_main.cc
@@ -134,6 +134,7 @@
 #include "media/base/localized_strings.h"
 #include "net/base/data_url.h"
 #include "net/base/module/net_module.h"
+#include "pantera/browser/pantera_browser_main_extra_parts.h"
 #include "pdf/buildflags.h"
 #include "rlz/buildflags/buildflags.h"
 #include "services/network/public/cpp/network_switches.h"
@@ -842,6 +843,10 @@
 
   main_parts->AddParts(std::make_unique<ChromeBrowserMainExtraPartsMemory>());
 
+  // Pantera's browser-wide services, such as the ad blocker.
+  main_parts->AddParts(
+      std::make_unique<pantera::PanteraBrowserMainExtraParts>());
+
   chrome::AddMetricsExtraParts(main_parts.get());
 
   main_parts->AddParts(
--- a/chrome/browser/prefs/BUILD.gn
+++ b/chrome/browser/prefs/BUILD.gn
@@ -61,6 +61,7 @@
     ":prefs",
     ":util",
     "//chrome/browser:browser_process",
+    "//pantera/browser",
     "//chrome/browser:browser_process_impl",
     "//chrome/browser:chrome_content_browser_client",
     "//chrome/browser:defaults",
--- a/chrome/browser/prefs/browser_prefs.cc
+++ b/chrome/browser/prefs/browser_prefs.cc
@@ -223,6 +223,7 @@
 #include "content/public/common/buildflags.h"
 #include "extensions/buildflags/buildflags.h"
 #include "net/http/http_server_properties_manager.h"
+#include "pantera/browser/pantera_prefs.h"
 #include "pdf/buildflags.h"
 #include "printing/buildflags/buildflags.h"
 #include "rlz/buildflags/buildflags.h"
@@ -1559,6 +1560,7 @@
   metrics::TabStatsTracker::RegisterPrefs(registry);
   network_time::NetworkTimeTracker::RegisterPrefs(registry);
   omnibox::RegisterLocalStatePrefs(registry);
+  pantera::RegisterLocalStatePrefs(registry);
 #if !BUILDFLAG(IS_ANDROID)
   omnibox_everywhere::prefs::RegisterLocalStatePrefs(registry);
 #endif
