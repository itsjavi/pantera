module pantera.mojom;

import "mojo/public/mojom/base/values.mojom";
import "url/mojom/url.mojom";

interface CosmeticFiltersResources {
  // Receives an input string which is JSON object.
  HiddenClassIdSelectors(string input, array<string> exceptions) => (
      mojo_base.mojom.DictionaryValue result);

  // The cosmetic resources for a frame at `url` whose top-level frame is at
  // `top_frame_url`, or null when shields are down for the top-level site.
  // The resources' "hide_first_party" says whether to hide the frame's
  // first-party content too.
  [Sync]
  UrlCosmeticResources(url.mojom.Url url,
                       url.mojom.Url top_frame_url,
                       bool cross_origin_to_top_frame) => (
      mojo_base.mojom.DictionaryValue? result);
};
