import("//tools/grit/grit_rule.gni")

# The cosmetic filters' script, packed into Chrome's resources.pak by
# patches/pantera/shields/add-cosmetic-filters.patch.
grit("resources") {
  source = "cosmetic_filters_resources.grd"
  outputs = [
    "grit/cosmetic_filters_resources.h",
    "cosmetic_filters_resources.pak",
  ]
  deps = [ "data:content_cosmetic" ]
}
