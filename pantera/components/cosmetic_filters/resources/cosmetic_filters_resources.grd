<?xml version="1.0" encoding="UTF-8"?>
<!-- The cosmetic filters' script, built from resources/data. -->
<grit latest_public_release="0" current_release="1">
  <outputs>
    <output filename="grit/cosmetic_filters_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="cosmetic_filters_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_PANTERA_COSMETIC_FILTERS_CONTENT_COSMETIC_JS"
               file="${root_gen_dir}/pantera/components/cosmetic_filters/resources/data/content_cosmetic.rollup.js"
               use_base_dir="false" type="BINDATA" compress="gzip" />
    </includes>
  </release>
</grit>
