import("//tools/grit/grit_rule.gni")

# Pantera's UI strings, packed into Chrome's locale paks
# (patches/pantera/browser/add-pantera-strings.patch).
grit_strings("pantera_strings") {
  source = "pantera_strings.grd"
  outputs = [ "grit/pantera_strings.h" ]
}
