<!-- Pantera's own UI strings. Locales without a translation show English. -->

<grit base_dir="." latest_public_release="0" current_release="1"
      source_lang_id="en" enc_check="möl">
  <outputs>
    <output filename="grit/pantera_strings.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
