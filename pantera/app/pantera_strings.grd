    <output filename="pantera_strings_ta.pak" type="data_package" lang="ta" />
    <output filename="pantera_strings_te.pak" type="data_package" lang="te" />
    <output filename="pantera_strings_th.pak" type="data_package" lang="th" />
    <output filename="pantera_strings_tr.pak" type="data_package" lang="tr" />
    <output filename="pantera_strings_uk.pak" type="data_package" lang="uk" />
    <output filename="pantera_strings_ur.pak" type="data_package" lang="ur" />
    <output filename="pantera_strings_uz.pak" type="data_package" lang="uz" />
    <output filename="pantera_strings_vi.pak" type="data_package" lang="vi" />
    <output filename="pantera_strings_zh-CN.pak" type="data_package" lang="zh-CN" />
    <output filename="pantera_strings_zh-HK.pak" type="data_package" lang="zh-HK" />
    <output filename="pantera_strings_zh-TW.pak" type="data_package" lang="zh-TW" />
    <output filename="pantera_strings_zu.pak" type="data_package" lang="zu" />
    <output filename="pantera_strings_ar-XB.pak" type="data_package" lang="ar-XB" />
    <output filename="pantera_strings_en-XA.pak" type="data_package" lang="en-XA" />
  </outputs>
  <release seq="1">
    <messages fallback_to_english="true">
      <!-- Shields toolbar button (TASK-7, DECISION-19). -->
      <message name="IDS_PANTERA_SHIELDS_BUTTON_TOOLTIP" desc="Tooltip of the toolbar button that opens the Shields panel, when Pantera's protections are on for the site.">
        Pantera Shields
      </message>
      <message name="IDS_PANTERA_SHIELDS_BUTTON_TOOLTIP_DOWN" desc="Tooltip of the toolbar button that opens the Shields panel, when the user turned Pantera's protections off for the site.">
        Pantera Shields are down for this site
      </message>
      <message name="IDS_PANTERA_SHIELDS_BUTTON_ACCNAME" desc="Accessible name of the Shields toolbar button, with the number of requests blocked on the page.">
        Pantera Shields, <ph name="COUNT">$1<ex>12</ex></ph> blocked
      </message>

      <!-- Shields panel. -->
      <message name="IDS_PANTERA_SHIELDS_STATUS" desc="Under the site's name in the Shields panel. The placeholder is the bold word 'up' or 'down'.">
        Shields <ph name="STATE">$1<ex>up</ex></ph> for this site
      </message>
      <message name="IDS_PANTERA_SHIELDS_STATUS_UP" desc="Bold word in 'Shields up for this site': the protections are on.">
        up
      </message>
      <message name="IDS_PANTERA_SHIELDS_STATUS_DOWN" desc="Bold word in 'Shields down for this site': the user turned the protections off.">
        down
      </message>
      <message name="IDS_PANTERA_SHIELDS_TOGGLE_ACCNAME" desc="Accessible name of the switch that turns Pantera's protections on or off for the site.">
        Shields for this site
      </message>
      <message name="IDS_PANTERA_SHIELDS_BLOCKED_COUNT" desc="After a large number in the Shields panel: how many requests were blocked on the page.">
        {COUNT, plural,
          =1 {tracker, ad, or more blocked}
          other {trackers, ads, and more blocked}}
      </message>
      <message name="IDS_PANTERA_SHIELDS_SHOW_BLOCKED" desc="Accessible name and tooltip of the arrow that opens the list of blocked requests.">
        Show what was blocked
      </message>
      <message name="IDS_PANTERA_SHIELDS_ADVANCED" desc="Heading of the expandable section with per-site protection settings.">
        Advanced options
      </message>
      <message name="IDS_PANTERA_SHIELDS_ADS_STANDARD" desc="Option of the trackers and ads setting: blocks third-party ads and trackers, sparing the site's own content.">
        Block trackers &amp; ads
      </message>
      <message name="IDS_PANTERA_SHIELDS_ADS_AGGRESSIVE" desc="Option of the trackers and ads setting: also blocks the site's own ads and trackers.">
        Aggressively block trackers &amp; ads
      </message>
      <message name="IDS_PANTERA_SHIELDS_ADS_ALLOW" desc="Option of the trackers and ads setting, not available yet: allows all ads and trackers while other protections stay on.">
        Allow all trackers &amp; ads
      </message>
      <message name="IDS_PANTERA_SHIELDS_ADS_ACCNAME" desc="Accessible name of the trackers and ads setting.">
        Trackers and ads blocking
      </message>
      <message name="IDS_PANTERA_SHIELDS_HTTPS" desc="Setting, not available per site yet: upgrade insecure connections to HTTPS.">
        Upgrade connections to HTTPS
      </message>
      <message name="IDS_PANTERA_SHIELDS_SCRIPTS" desc="Switch that blocks JavaScript on the site.">
        Block scripts
      </message>
      <message name="IDS_PANTERA_SHIELDS_FINGERPRINTING" desc="Switch, not available yet: blocks browser fingerprinting on the site.">
        Block fingerprinting
      </message>
      <message name="IDS_PANTERA_SHIELDS_COOKIES_THIRD_PARTY" desc="Option of the cookies setting: blocks third-party cookies on the site.">
        Block third-party cookies
      </message>
      <message name="IDS_PANTERA_SHIELDS_COOKIES_ALL" desc="Option of the cookies setting: blocks all cookies on the site.">
        Block all cookies
      </message>
      <message name="IDS_PANTERA_SHIELDS_COOKIES_ALLOW" desc="Option of the cookies setting: allows all cookies on the site.">
        Allow all cookies
      </message>
      <message name="IDS_PANTERA_SHIELDS_COOKIES_ACCNAME" desc="Accessible name of the cookies setting.">
        Cookies on this site
      </message>
      <message name="IDS_PANTERA_SHIELDS_FORGET_ME" desc="Switch, not available yet: deletes the site's data when the user closes it.">
        Forget me when I close this site
      </message>
      <message name="IDS_PANTERA_SHIELDS_COMING_SOON" desc="Under a Shields setting that Pantera doesn't have yet.">
        Coming soon
      </message>
      <message name="IDS_PANTERA_SHIELDS_FILTER_LISTS" desc="Button, not available yet: opens the filter lists settings.">
        Filter lists
      </message>
      <message name="IDS_PANTERA_SHIELDS_GLOBAL_SETTINGS" desc="Button, not available yet: opens the global Shields settings.">
        Global settings
      </message>
      <message name="IDS_PANTERA_SHIELDS_FOOTER" desc="Hint at the bottom of the Shields panel.">
        If this site seems broken, try Shields down. This may reduce Pantera's privacy protections.
      </message>

      <!-- List of blocked requests. -->
      <message name="IDS_PANTERA_SHIELDS_BLOCKED_TITLE" desc="Title of the Shields panel page that lists the requests blocked on the page.">
        Blocked on this page
      </message>
      <message name="IDS_PANTERA_SHIELDS_BLOCKED_EMPTY" desc="Shown in the list of blocked requests when nothing was blocked.">
        Nothing was blocked on this page.
      </message>
      <message name="IDS_PANTERA_SHIELDS_BACK" desc="Accessible name and tooltip of the button that goes back to the main Shields panel.">
        Back
      </message>
    </messages>
  </release>
</grit>
