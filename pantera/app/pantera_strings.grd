    <output filename="pantera_strings_or.pak" type="data_package" lang="or" />
    <output filename="pantera_strings_ro.pak" type="data_package" lang="ro" />
    <output filename="pantera_strings_ru.pak" type="data_package" lang="ru" />
    <output filename="pantera_strings_si.pak" type="data_package" lang="si" />
    <output filename="pantera_strings_sk.pak" type="data_package" lang="sk" />
    <output filename="pantera_strings_sl.pak" type="data_package" lang="sl" />
